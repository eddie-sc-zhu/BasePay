# base-sepolia (default) | base | localhost
VITE_CHAIN=base-sepolia
# Optional custom RPC (defaults to the chain's public RPC)
VITE_RPC_URL=
# BasePayRouter address. Leave empty to fall back to plain USDC transfers.
VITE_ROUTER_ADDRESS=
# Only needed for localhost (MockUSDC); Base/Base Sepolia use Circle's USDC
VITE_USDC_ADDRESS=
VITE_API_URL=http://localhost:8000
# Optional, enables WalletConnect (cloud.reown.com)
VITE_WALLETCONNECT_PROJECT_ID=
