# 84532 = Base Sepolia, 8453 = Base mainnet
CHAIN_ID=84532
# Defaults to the public Base RPC for CHAIN_ID; use Alchemy/QuickNode/etc. for higher limits
RPC_URL=
# Defaults to Circle's USDC for CHAIN_ID
USDC_ADDRESS=
# BasePayRouter address (printed by `npm run deploy:base-sepolia` in contracts/)
ROUTER_ADDRESS=
DATABASE_URL=sqlite:///./basepay.db
LOG_CHUNK_SIZE=5000
INITIAL_LOOKBACK_BLOCKS=50000
POLL_SECONDS=30
